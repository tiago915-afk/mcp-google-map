# --- Claude (rédaction des posts) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Meta : Facebook Page + Instagram professionnel ---
# Jeton d'accès de PAGE longue durée (permissions : pages_manage_posts,
# pages_read_engagement, instagram_basic, instagram_content_publish)
META_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
# ID du compte Instagram Business/Creator lié à la Page
INSTAGRAM_BUSINESS_ID=
META_GRAPH_VERSION=v23.0

# --- LinkedIn ---
# Jeton OAuth 2.0 avec w_member_social (profil) ou w_organization_social (page entreprise)
LINKEDIN_ACCESS_TOKEN=
# urn:li:person:XXXX (profil) ou urn:li:organization:XXXX (page entreprise)
LINKEDIN_AUTHOR_URN=
# Version de l'API LinkedIn (format AAAAMM)
LINKEDIN_VERSION=202606
